    <circle cx="0" cy="-10" r="25" fill="#fff"/>
    <ellipse cx="0" cy="35" rx="35" ry="25" fill="#fff"/>
  </g>
  <rect x="50" y="350" width="300" height="120" fill="#fff" opacity="0.95" rx="8"/>
