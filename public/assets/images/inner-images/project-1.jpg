<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400">
  <rect width="600" height="400" fill="#F3F4F6"/>
  <g transform="translate(300, 200)">
    <rect x="-200" y="-150" width="400" height="300" fill="#E5E7EB" rx="10"/>
    <circle cx="0" cy="-40" r="50" fill="#3B82F6" opacity="0.2"/>
    <rect x="-30" y="-60" width="60" height="80" fill="none" stroke="#3B82F6" stroke-width="4" rx="5"/>
    <line x1="-20" y1="-40" x2="20" y2="-40" stroke="#3B82F6" stroke-width="3"/>
    <line x1="-20" y1="-20" x2="20" y2="-20" stroke="#3B82F6" stroke-width="3"/>
    <line x1="-20" y1="0" x2="20" y2="0" stroke="#3B82F6" stroke-width="3"/>
    <text x="0" y="80" text-anchor="middle" font-family="Arial, sans-serif" font-size="22" fill="#6B7280">Project Image</text>
  </g>
</svg>
