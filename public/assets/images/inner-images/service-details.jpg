<svg xmlns="http://www.w3.org/2000/svg" width="800" height="500" viewBox="0 0 800 500">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1e3a8a;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#3b82f6;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="500" fill="url(#bgGrad)"/>
  <g opacity="0.1">
    <circle cx="100" cy="100" r="80" fill="#fff"/>
    <circle cx="700" cy="400" r="100" fill="#fff"/>
    <circle cx="400" cy="250" r="150" fill="#fff"/>
  </g>
  <g transform="translate(400, 250)">
    <rect x="-250" y="-150" width="500" height="300" fill="#fff" opacity="0.95" rx="10"/>
    <g transform="translate(0, -50)">
      <circle cx="0" cy="0" r="50" fill="#3b82f6" opacity="0.2"/>
      <circle cx="0" cy="0" r="35" fill="#3b82f6" opacity="0.3"/>
      <path d="M -20,-10 L -20,20 L 20,20 L 20,-10 Z" fill="none" stroke="#3b82f6" stroke-width="3"/>
      <path d="M -15,-15 L 0,-25 L 15,-15" fill="none" stroke="#3b82f6" stroke-width="3" stroke-linejoin="round"/>
      <line x1="-12" y1="-3" x2="12" y2="-3" stroke="#3b82f6" stroke-width="2.5"/>
      <line x1="-12" y1="5" x2="12" y2="5" stroke="#3b82f6" stroke-width="2.5"/>
      <line x1="-12" y1="13" x2="12" y2="13" stroke="#3b82f6" stroke-width="2.5"/>
    </g>
    <text x="0" y="80" text-anchor="middle" font-family="Arial, sans-serif" font-size="28" font-weight="bold" fill="#1e3a8a">Service Details</text>
    <text x="0" y="110" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" fill="#64748b">Professional IT Solutions</text>
  </g>
</svg>
